{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:mobile": "npm run build:mobile:bundled",
    "build:mobile:bundled": "cross-env NEXT_STATIC_EXPORT=true NEXT_PUBLIC_MOBILE_APP=true node ./scripts/build-mobile.mjs",
    "start": "next start",
    "lint": "eslint .",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:add:ios": "npx cap add ios",
    "mobile:prepare:android": "npx cap sync android",
    "mobile:prepare:android:bundled": "npm run build:mobile:bundled && npx cap sync android",
    "mobile:android:bundle:release": "npm run build:mobile:bundled && npx cap sync android && cd android && gradlew.bat bundleRelease",
    "mobile:android:apk:release": "npm run build:mobile:bundled && npx cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.6",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "immer": "^11.1.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "victory-vendor": "^37.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.1.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
