# Copier vers les variables d'environnement Vercel (ou .env.production local pour test build)
# URL publique de l API (sans slash final)
NEXT_PUBLIC_API_URL=https://api.example.com
# URL canonique du site (www ou apex), pour la Content-Security Policy
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optionnel : origines supplementaires pour connect-src (separees par des virgules)
# NEXT_PUBLIC_CSP_CONNECT_EXTRA=https://region.chatgpt.com
