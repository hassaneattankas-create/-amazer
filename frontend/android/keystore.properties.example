# Copier vers keystore.properties (déjà ignoré par git) pour signer la release Play Store.
# Générer le fichier JKS une seule fois :
#   keytool -genkeypair -v -storetype PKCS12 -keystore upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../upload-keystore.jks
storePassword=remplacer
keyAlias=upload
keyPassword=remplacer
