# Copier vers .env.mobile (non versionné) avant : npm run build:mobile:bundled
#
# Origine HTTPS de l’API FastAPI uniquement (sans chemin /api/v1).
# Exemple si l’API est sur https://api.mondomaine.ne
MOBILE_BACKEND_ORIGIN=https://api.mondomaine.ne

# Optionnel : si un site Next.js avec rewrites /backend-api existe encore,
# l’APK peut passer par ce proxy au lieu d’appeler l’API directement.
# NEXT_PUBLIC_MOBILE_SITE_URL=https://www.mondomaine.ne
